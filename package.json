{
  "name": "agent-desk",
  "version": "0.0.1",
  "private": true,
  "bin": { "agent-desk": "dist/doctor.js" },
  "description": "Readable, segregated web cockpit over persistent coding-agent sessions",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite web",
    "build": "tsc -p . && vite build web --outDir ../dist/web --emptyOutDir",
    "start": "node dist/server.js",
    "doctor": "tsx src/doctor.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
